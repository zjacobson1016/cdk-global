{
  "datasets": [
    {
      "name": "survey_data",
      "displayName": "Survey Responses",
      "queryLines": [
        "SELECT ",
        "  response_id, ",
        "  customer_segment, ",
        "  product_interest, ",
        "  nps_score, ",
        "  nps_category, ",
        "  purchase_intent, ",
        "  purchase_intent_score, ",
        "  price_perception_score, ",
        "  competitor_comparison, ",
        "  ai_derived_sentiment, ",
        "  calculated_sentiment_score, ",
        "  purchase_readiness_score, ",
        "  predicted_customer_segment, ",
        "  purchase_timeline, ",
        "  campaign_source, ",
        "  distribution_channel, ",
        "  CONCAT(respondent_first_name, ' ', respondent_last_name) as respondent_name, ",
        "  respondent_state, ",
        "  open_feedback, ",
        "  recorded_date ",
        "FROM mfg_mc_se_sa.cdk.silver_survey_responses"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Survey Analytics",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": ["## New Product Survey Analytics"]
            }
          },
          "position": {"x": 0, "y": 0, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "subtitle",
            "multilineTextboxSpec": {
              "lines": ["Qualtrics survey response insights with AI-derived sentiment analysis"]
            }
          },
          "position": {"x": 0, "y": 1, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "total-responses",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [{"name": "count(response_id)", "expression": "COUNT(`response_id`)"}],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "count(response_id)", "displayName": "Total Responses"}
              },
              "frame": {"showTitle": true, "title": "Total Responses"}
            }
          },
          "position": {"x": 0, "y": 2, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "avg-nps-score",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [{"name": "avg(nps_score)", "expression": "AVG(`nps_score`)"}],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "avg(nps_score)", "displayName": "Avg NPS Score"}
              },
              "frame": {"showTitle": true, "title": "Avg NPS Score"}
            }
          },
          "position": {"x": 2, "y": 2, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "avg-readiness",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [{"name": "avg(purchase_readiness_score)", "expression": "AVG(`purchase_readiness_score`)"}],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "avg(purchase_readiness_score)", "displayName": "Avg Purchase Readiness"}
              },
              "frame": {"showTitle": true, "title": "Avg Purchase Readiness"}
            }
          },
          "position": {"x": 4, "y": 2, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "section-sentiment",
            "multilineTextboxSpec": {
              "lines": ["### Sentiment & NPS Analysis"]
            }
          },
          "position": {"x": 0, "y": 5, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "ai-sentiment-pie",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [
                  {"name": "ai_derived_sentiment", "expression": "`ai_derived_sentiment`"},
                  {"name": "count(response_id)", "expression": "COUNT(`response_id`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {"fieldName": "count(response_id)", "scale": {"type": "quantitative"}, "displayName": "Responses"},
                "color": {"fieldName": "ai_derived_sentiment", "scale": {"type": "categorical"}, "displayName": "AI Sentiment"}
              },
              "frame": {"showTitle": true, "title": "AI-Derived Sentiment Distribution"}
            }
          },
          "position": {"x": 0, "y": 6, "width": 3, "height": 5}
        },
        {
          "widget": {
            "name": "nps-category-pie",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [
                  {"name": "nps_category", "expression": "`nps_category`"},
                  {"name": "count(response_id)", "expression": "COUNT(`response_id`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {"fieldName": "count(response_id)", "scale": {"type": "quantitative"}, "displayName": "Responses"},
                "color": {"fieldName": "nps_category", "scale": {"type": "categorical"}, "displayName": "NPS Category"}
              },
              "frame": {"showTitle": true, "title": "NPS Category Distribution"}
            }
          },
          "position": {"x": 3, "y": 6, "width": 3, "height": 5}
        },
        {
          "widget": {
            "name": "section-product",
            "multilineTextboxSpec": {
              "lines": ["### Product & Purchase Analysis"]
            }
          },
          "position": {"x": 0, "y": 11, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "responses-by-product",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [
                  {"name": "product_interest", "expression": "`product_interest`"},
                  {"name": "count(response_id)", "expression": "COUNT(`response_id`)"},
                  {"name": "ai_derived_sentiment", "expression": "`ai_derived_sentiment`"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "product_interest", "scale": {"type": "categorical"}, "displayName": "Product"},
                "y": {"fieldName": "count(response_id)", "scale": {"type": "quantitative"}, "displayName": "Responses"},
                "color": {"fieldName": "ai_derived_sentiment", "scale": {"type": "categorical"}, "displayName": "Sentiment"}
              },
              "frame": {"showTitle": true, "title": "Responses by Product & Sentiment"}
            }
          },
          "position": {"x": 0, "y": 12, "width": 3, "height": 6}
        },
        {
          "widget": {
            "name": "purchase-intent-bar",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [
                  {"name": "purchase_intent", "expression": "`purchase_intent`"},
                  {"name": "count(response_id)", "expression": "COUNT(`response_id`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "purchase_intent", "scale": {"type": "categorical"}, "displayName": "Purchase Intent"},
                "y": {"fieldName": "count(response_id)", "scale": {"type": "quantitative"}, "displayName": "Responses"}
              },
              "frame": {"showTitle": true, "title": "Purchase Intent Distribution"}
            }
          },
          "position": {"x": 3, "y": 12, "width": 3, "height": 6}
        },
        {
          "widget": {
            "name": "section-scores",
            "multilineTextboxSpec": {
              "lines": ["### Score Comparisons by Customer Segment"]
            }
          },
          "position": {"x": 0, "y": 18, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "nps-by-segment-bar",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [
                  {"name": "customer_segment", "expression": "`customer_segment`"},
                  {"name": "avg(nps_score)", "expression": "AVG(`nps_score`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "customer_segment", "scale": {"type": "categorical"}, "displayName": "Customer Segment"},
                "y": {"fieldName": "avg(nps_score)", "scale": {"type": "quantitative"}, "displayName": "Avg NPS Score"}
              },
              "frame": {"showTitle": true, "title": "Avg NPS Score by Customer Segment"}
            }
          },
          "position": {"x": 0, "y": 19, "width": 3, "height": 6}
        },
        {
          "widget": {
            "name": "readiness-by-segment-bar",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [
                  {"name": "customer_segment", "expression": "`customer_segment`"},
                  {"name": "avg(purchase_readiness_score)", "expression": "AVG(`purchase_readiness_score`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "customer_segment", "scale": {"type": "categorical"}, "displayName": "Customer Segment"},
                "y": {"fieldName": "avg(purchase_readiness_score)", "scale": {"type": "quantitative"}, "displayName": "Avg Purchase Readiness"}
              },
              "frame": {"showTitle": true, "title": "Avg Purchase Readiness by Customer Segment"}
            }
          },
          "position": {"x": 3, "y": 19, "width": 3, "height": 6}
        },
        {
          "widget": {
            "name": "section-details",
            "multilineTextboxSpec": {
              "lines": ["### Response Details"]
            }
          },
          "position": {"x": 0, "y": 25, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "response-table",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "survey_data",
                "fields": [
                  {"name": "respondent_name", "expression": "`respondent_name`"},
                  {"name": "customer_segment", "expression": "`customer_segment`"},
                  {"name": "product_interest", "expression": "`product_interest`"},
                  {"name": "nps_score", "expression": "`nps_score`"},
                  {"name": "nps_category", "expression": "`nps_category`"},
                  {"name": "purchase_intent", "expression": "`purchase_intent`"},
                  {"name": "ai_derived_sentiment", "expression": "`ai_derived_sentiment`"},
                  {"name": "purchase_readiness_score", "expression": "`purchase_readiness_score`"},
                  {"name": "open_feedback", "expression": "`open_feedback`"}
                ],
                "disaggregated": true
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {"fieldName": "respondent_name", "displayName": "Respondent"},
                  {"fieldName": "customer_segment", "displayName": "Segment"},
                  {"fieldName": "product_interest", "displayName": "Product Interest"},
                  {"fieldName": "nps_score", "displayName": "NPS"},
                  {"fieldName": "nps_category", "displayName": "NPS Category"},
                  {"fieldName": "purchase_intent", "displayName": "Purchase Intent"},
                  {"fieldName": "ai_derived_sentiment", "displayName": "AI Sentiment"},
                  {"fieldName": "purchase_readiness_score", "displayName": "Readiness Score"},
                  {"fieldName": "open_feedback", "displayName": "Feedback"}
                ]
              },
              "frame": {"showTitle": true, "title": "Survey Response Details"}
            }
          },
          "position": {"x": 0, "y": 26, "width": 6, "height": 7}
        }
      ]
    },
    {
      "name": "filters",
      "displayName": "Filters",
      "pageType": "PAGE_TYPE_GLOBAL_FILTERS",
      "layout": [
        {
          "widget": {
            "name": "filter-customer-segment",
            "queries": [{
              "name": "survey_data_customer_segment",
              "query": {
                "datasetName": "survey_data",
                "fields": [{"name": "customer_segment", "expression": "`customer_segment`"}],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [{
                  "fieldName": "customer_segment",
                  "displayName": "Customer Segment",
                  "queryName": "survey_data_customer_segment"
                }]
              },
              "frame": {"showTitle": true, "title": "Customer Segment"}
            }
          },
          "position": {"x": 0, "y": 0, "width": 2, "height": 2}
        },
        {
          "widget": {
            "name": "filter-product-interest",
            "queries": [{
              "name": "survey_data_product_interest",
              "query": {
                "datasetName": "survey_data",
                "fields": [{"name": "product_interest", "expression": "`product_interest`"}],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [{
                  "fieldName": "product_interest",
                  "displayName": "Product Interest",
                  "queryName": "survey_data_product_interest"
                }]
              },
              "frame": {"showTitle": true, "title": "Product Interest"}
            }
          },
          "position": {"x": 2, "y": 0, "width": 2, "height": 2}
        },
        {
          "widget": {
            "name": "filter-ai-sentiment",
            "queries": [{
              "name": "survey_data_ai_sentiment",
              "query": {
                "datasetName": "survey_data",
                "fields": [{"name": "ai_derived_sentiment", "expression": "`ai_derived_sentiment`"}],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [{
                  "fieldName": "ai_derived_sentiment",
                  "displayName": "AI Sentiment",
                  "queryName": "survey_data_ai_sentiment"
                }]
              },
              "frame": {"showTitle": true, "title": "AI Sentiment"}
            }
          },
          "position": {"x": 4, "y": 0, "width": 2, "height": 2}
        }
      ]
    }
  ]
}
